{
    "name": "soldank-plus-plus",
    "version": "1.0.0",
    "description": "Frontend for Soldank++ website built with Vite, React, TypeScript, OpenAPI, TanStack, Tailwind CSS, and Shadcn as UI library",
    "author": "max-ghz",
    "private": true,
    "license": "MIT",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:security": "vitest run src/__tests__/security",
        "test:coverage": "vitest run --coverage",
        "generate:api-types": "openapi-codegen gen spp && prettier --write src/api/generated",
        "prepare": "husky",
        "pre-push": "npm run lint && npm run type-check && npm run test"
    },
    "dependencies": {
        "@fontsource/tomorrow": "^5.3.0",
        "@radix-ui/react-accordion": "^1.2.11",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-hover-card": "^1.1.15",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-scroll-area": "^1.2.9",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tanstack/react-query": "^5.102.8",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "embla-carousel-react": "^8.6.0",
        "framer-motion": "^12.12.1",
        "jszip": "^3.10.1",
        "lucide-react": "^0.511.0",
        "puppeteer": "^24.43.1",
        "radix-ui": "^1.4.3",
        "react": "^18.2.0",
        "react-country-flag": "^3.1.0",
        "react-dom": "^18.2.0",
        "react-icons": "^5.6.0",
        "react-resizable-panels": "^3.0.2",
        "react-router-dom": "^7.18.3",
        "recharts": "^3.5.1",
        "tailwind-merge": "^3.3.0",
        "tailwindcss-animate": "^1.0.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.27.0",
        "@openapi-codegen/cli": "^3.1.0",
        "@openapi-codegen/typescript": "^11.1.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^22.15.21",
        "@types/react": "^18.2.14",
        "@types/react-dom": "^18.2.7",
        "@vitejs/plugin-react": "^4.0.3",
        "@vitest/coverage-v8": "^4.1.11",
        "autoprefixer": "^10.4.14",
        "eslint": "^9.27.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-jsonc": "^2.20.1",
        "eslint-plugin-prettier": "^5.4.1",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^16.2.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^16.4.0",
        "postcss": "^8.4.21",
        "prettier": "^3.5.3",
        "tailwindcss": "^3.3.2",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.33.0",
        "vite": "^6.3.5",
        "vitest": "^4.1.11"
    }
}
